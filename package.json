{
  "name": "martensc.github.io",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build:eleventy": "eleventy",
    "clean": "rm -rf _site encrypted",
    "prettier:check": "prettier --check \"src/**/*.css\"",
    "prettier:fix": "prettier --write \"src/**/*.css\"",
    "encrypt:work": "bash -c 'for file in _site/work.html $(find _site/work -name \"*.html\" -type f); do npx staticrypt \"$file\" -d \"$(dirname \"$file\")\" -p \"${STATICRYPT_PASSWORD:-my portfolio work}\" -l \"View Work\"; done'",
    "dev": "npm run prettier:check && eleventy --serve",
    "dev:encrypted": "npm run prettier:check && ./encrypt-watch.sh & eleventy --serve",
    "start": "npm run dev",
    "start:encrypted": "npm run dev:encrypted",
    "build": "npm run clean && npm run build:eleventy && npm run encrypt:work && rsync -av _site/ encrypted/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "minimatch": "^3.1.4"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "browserslist": "^4.29.5",
    "js-yaml": "^4.3.2",
    "lightningcss": "^1.33.0",
    "normalize.css": "^8.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "staticrypt": "^3.5.4",
    "twig": "^3.0.0"
  }
}
