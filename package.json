{
  "name": "martensc.github.io",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build:css": "NODE_ENV=production postcss src/css/styles.css -o _site/css/styles.min.css --no-map",
    "watch:css": "NODE_ENV=development postcss src/css/styles.css -o _site/css/styles.min.css --watch --map",
    "clean": "rm -r _site",
    "prettier:check": "npx prettier --check \"src/**/*.css\"",
    "encrypt:work": "npx staticrypt _site/work.html _site/work/*.html -r -p \"${STATICRYPT_PASSWORD:-my portfolio work}\"",
    "start": "npm run prettier:check && npm run watch:css & eleventy --serve",
    "start:encrypted": "npm run prettier:check && npm run watch:css & ./encrypt-watch.sh & eleventy --serve",
    "build": "npm run build:css && eleventy && npm run encrypt:work && rsync -av --exclude='work.html' --exclude='work/' _site/ encrypted/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "autoprefixer": "^10.4.27",
    "cssnano": "^7.1.2",
    "js-yaml": "^4.1.1",
    "normalize.css": "^8.0.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-css-order": "^2.2.0",
    "staticrypt": "^3.5.4",
    "twig": "^1.17.1"
  }
}
