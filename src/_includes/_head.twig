<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta name="description" content="{{ metaDesc }}">
    {% if noindex %}
      <meta name="robots" content="noindex">
    {% else %}
      <meta name="robots" content="index, follow">
    {% endif %}
    <title>{{ site.siteName }} | {{ metaTitle }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="{{ path }}css/styles.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="{{ path }}img/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ path }}img/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ path }}img/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ path }}img/favicon-16x16.png">
    <link rel="manifest" href="{{ path }}site.webmanifest">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6V55NQ1B75"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6V55NQ1B75');
    </script>
  </head>
